# IPS backend (BFF) — 环境变量模板
# 复制为 .env.development（开发）或 .env.production（生产）并填写
# dotenv 按 NODE_ENV 加载：production → .env.production，其他 → .env.development

# ---- EADAF ----
EADAF_API_BASE_URL=http://localhost:29527
EADAF_FRONTEND_URL=http://localhost:29527
IPS_APP_CODE=IPS
IPS_APPLICATION_ID=10000000-0001-4000-8000-000000000005
# 64 位十六进制密钥，从 EADAF 三方应用「密钥管理」获取
IPS_APP_SECRET=
# EADAF 文件桶编码。示意图走 POST /api/v1/storage/objects/upload
EADAF_STORAGE_BUCKET=fmms

# ---- SSO ----
# 与 EADAF SSO 配置中的「签名盐值」一致
SSO_JWT_SALT=
SSO_REDIRECT_MODE=POST_REDIRECT
SSO_CALLBACK_URL=http://localhost:6081/auth/callback

# ---- BFF ----
BFF_PORT=6081
BFF_CORS_ORIGIN=http://localhost:6082
FRONTEND_URL=http://localhost:6082
# WebSocket 推送路径（前端连接 ws://host:port${BFF_WS_PATH}）
BFF_WS_PATH=/ws/ips
