# web/backend (BFF) — 环境变量模板
# 复制为 .env.development（开发）或 .env.production（生产）并填写
# dotenv 按 NODE_ENV 加载：production → .env.production，其他 → .env.development

# ---- EADAF ----
EADAF_API_BASE_URL=http://localhost:29526
EADAF_FRONTEND_URL=http://localhost:29527
FMMS_APP_CODE=FMMS
FMMS_APPLICATION_ID=10000000-0001-4000-8000-000000000006
# 64 位十六进制密钥，从 EADAF 三方应用「密钥管理」获取
FMMS_APP_SECRET=
# 向 EADAF 管理员索要初始 token；首次换取后 BFF 自动用旧 token 刷新，不再依赖此项

# ---- SSO（授权码 + PKCE，令牌只留在 BFF）----
# 必须与 EADAF 应用登记的回调一致。当前登记的是跟随主机的 :5181/auth/callback
SSO_CALLBACK_URL=http://localhost:5181/auth/callback

# ---- BFF ----
BFF_PORT=5180
BFF_CORS_ORIGIN=http://localhost:5181
# 前端地址（SSO 回调重定向目标）
FRONTEND_URL=http://localhost:5181

# ---- 采集回调（/api/collect/*，客户要求不认证）----
# 来源 IP 白名单，逗号分隔。留空则全部拒绝。本机调试可填 127.0.0.1,::1
COLLECT_ALLOWED_IPS=
